                </mxCell>
                <mxCell id="nL2glmRdDixTsG3Ix024-5" value="Nuestro laboratorio ha renovado su certificación ISO-17025, garantizando calidad y confianza." style="whiteSpace=wrap;html=1;fillColor=#1ba1e2;rounded=1;strokeWidth=2;fillWeight=4;hachureGap=8;hachureAngle=45;sketch=1;" parent="1" vertex="1">
                    <mxGeometry x="-480" y="590" width="130" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="nL2glmRdDixTsG3Ix024-7" value="Descubre las nuevas regulaciones ambientales y cómo cumplirlas fácilmente." style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=2;fillWeight=4;hachureGap=8;hachureAngle=45;fillColor=#1ba1e2;sketch=1;" parent="1" vertex="1">
                    <mxGeometry x="-680" y="730" width="120" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="nL2glmRdDixTsG3Ix024-9" value="Participaremos en la Expo Medio Ambiente 2025. ¡Visítanos en nuestro stand!" style="whiteSpace=wrap;html=1;fillColor=#1ba1e2;rounded=1;strokeWidth=2;fillWeight=4;hachureGap=8;hachureAngle=45;sketch=1;" parent="1" vertex="1">
                    <mxGeometry x="-480" y="870" width="120" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="nL2glmRdDixTsG3Ix024-11" value="" style="endArrow=classic;html=1;" parent="1" edge="1">
